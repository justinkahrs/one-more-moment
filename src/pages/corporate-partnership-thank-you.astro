---
import Base from "../layouts/Base.astro";

const pageTitle = "Thank You for Your Partnership Inquiry | One More Moment";
const pageDescription =
  "Confirmation that One More Moment received your corporate partnership inquiry.";
---

<Base
  title={pageTitle}
  description={pageDescription}
  robots="noindex, nofollow"
>
  <section class="bg-[#FFFBF6]">
    <div
      class="container mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-4 py-20 text-center"
    >
      <p
        class="mb-4 text-sm font-semibold tracking-wide text-[#D9776E] uppercase"
      >
        Corporate Partnerships
      </p>
      <h1
        class="mb-6 font-serif text-5xl leading-tight text-[#2B2B40] md:text-6xl"
      >
        Thank You for Reaching Out
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-[#333333]">
        Your corporate partnership inquiry has been received. A member of the
        One More Moment team will review your information and follow up with you
        soon.
      </p>
      <a
        href="/"
        class="btn mt-10 rounded-md border-0 bg-[#D9776E] px-8 text-white hover:bg-[#c5665d]"
      >
        Return to One More Moment
      </a>
      <a href="/about/" class="mt-5 font-semibold text-[#D9776E] underline">
        Learn More About Our Mission
      </a>
    </div>
  </section>
</Base>
