---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { fade } from "astro:transitions";
import { frontmatter as meta } from "../data/metadata.mdx";

const {
  title,
  description: pageDescription,
  overlayHeader = false,
  image = meta.seo?.ogImage || "/og-image.png",
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  ogType = "website",
  canonicalUrl,
  robots = "index, follow",
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;

const seo = meta.seo || {};
const siteUrl = Astro.site || new URL("https://www.onemoremoment.org");

const pageTitle =
  title || seo.title || `${meta.name}${meta.primaryService ? ` | ${meta.primaryService}` : ""}`;

const description = pageDescription || seo.description || (meta.hero && meta.hero.content) || "";
const canonical = new URL(canonicalUrl || Astro.url.pathname, siteUrl).toString();
const socialImage = new URL(image, siteUrl).toString();
const resolvedImageType =
  imageType ||
  (socialImage.endsWith(".png")
    ? "image/png"
    : socialImage.endsWith(".jpg") || socialImage.endsWith(".jpeg")
      ? "image/jpeg"
      : socialImage.endsWith(".webp")
        ? "image/webp"
        : undefined);

const keywords = [
  seo.cityKeyword,
  seo.serviceKeyword,
  meta.serviceCategory,
  meta.primaryService,
  meta.primaryAudience,
  meta.industryNiche,
  meta.regionsServed,
]
  .filter(Boolean)
  .join(", ");
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-9TXZJ8T4G1"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", "G-9TXZJ8T4G1");
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={meta.name} />
    <meta name="msvalidate.01" content="D5B4BA51F2F2AC205901468B0C2EB509" />
    {
      meta.location?.cityState && (
        <meta name="geo.placename" content={meta.location.cityState} />
      )
    }
    {
      meta.location?.state && (
        <meta name="geo.region" content={meta.location.state} />
      )
    }
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    {resolvedImageType && <meta property="og:image:type" content={resolvedImageType} />}
    {imageWidth && <meta property="og:image:width" content={imageWidth} />}
    {imageHeight && <meta property="og:image:height" content={imageHeight} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content="en_US" />
    {
      ogType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      ogType === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      ogType === "article" && author && (
        <meta property="article:author" content={author} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <slot name="head" />
  </head>

  <body class="bg-base-100 text-base-content flex min-h-screen flex-col">
    <Header overlay={overlayHeader} />
    <main class="flex-1" transition:animate={fade({ duration: 250 })}>
      <slot />
    </main>
    <Footer />
    <slot name="overlay" />
  </body>
</html>
